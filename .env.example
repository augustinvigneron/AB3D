# ───────────── Supabase (obligatoire pour l'auth et les données) ─────────────
# Projet Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé "publishable" (sb_publishable_...) ou ancienne clé "anon" : les deux fonctionnent.
# Cette clé est publique par conception ; la sécurité repose sur les politiques RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# URL publique du site (liens dans les emails de confirmation / reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────────── Assistant IA (optionnel : sans clé, mode simulation) ─────────────
# Fournisseur : "anthropic" ou "openai" (ou tout endpoint compatible OpenAI)
AI_PROVIDER=anthropic
AI_API_KEY=
# Modèle : ex. claude-sonnet-5-5 (Anthropic) ou gpt-4o-mini (OpenAI)
AI_MODEL=claude-sonnet-5-5
# Optionnel : URL de base personnalisée (ex. endpoint compatible OpenAI auto-hébergé)
AI_BASE_URL=

# ───────────── Stripe (phase ultérieure, optionnel) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Clé service_role Supabase : UNIQUEMENT côté serveur, utilisée par le webhook
# Stripe pour changer le plan d'un utilisateur après paiement vérifié.
# Ne commence jamais par NEXT_PUBLIC_. Ne jamais la partager.
SUPABASE_SERVICE_ROLE_KEY=
